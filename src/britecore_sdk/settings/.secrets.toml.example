# BriteCore SDK Configuration Example
#
# RENAME THIS FILE TO .secrets.toml AND FILL IN YOUR ACTUAL VALUES
# This file should contain sensitive credentials and is typically in .gitignore
#
# DO NOT commit actual credentials to version control!
# Use environment variables or secure credential management for CI/CD.

# Example: OAuth authentication site
[production]
base_url = "https://api.britecore.example.com"
client_id = "your-client-id-here"
client_secret = "your-client-secret-here"

# Example: API Key authentication site
[staging]
base_url = "https://staging-api.britecore.example.com"
api_key = "your-api-key-here"

# Example: Another OAuth site
[development]
base_url = "https://dev-api.britecore.example.com"
client_id = "dev-client-id"
client_secret = "dev-client-secret"

