# BriteCore SDK Settings Example
#
# This file demonstrates all available configuration settings.
# Settings defined here are NOT sensitive and CAN be committed to version control.
#
# For sensitive credentials (base_url, api_key, client_id, client_secret),
# use .secrets.toml instead (see .secrets.toml.example).

[default]
# === HTTP Configuration ===

# Standard HTTP request timeout in seconds.
# Hard-coded default: 5 seconds
# Set lower for faster fail-fast behavior, higher for slower networks.
web_timeout = 30

# Long timeout for long-running operations.
# Hard-coded default: 50 seconds (calculated as 10x web_timeout if omitted)
# Automatically calculated from web_timeout if not specified.
web_timeout_long = 60

# Number of retries for failed HTTP requests.
# Hard-coded default: 5 retries
# Retries apply to 500, 502, 503, 504 errors with exponential backoff.
web_retry = 10

# === Rate Limiting ===

# Enable client-side rate limiting (opt-in).
# Hard-coded default: False
# When enabled, outbound requests are throttled client-side to stay below
# the configured rate limit. The rate limiter uses token bucket algorithm.
rate_limiter_enabled = false

# Target request rate when rate limiting is enabled (requests per second).
# Hard-coded default: 10.0 req/s
# Recommendations:
#   - Conservative (safe): 5.0 req/s
#   - Moderate (balanced): 10.0 req/s
#   - Aggressive (server-permitting): 20.0 req/s
rate_limiter_requests_per_second = 10.0

# Maximum burst size (in number of requests) when rate limiting is enabled.
# Hard-coded default: 20 requests
# This allows short bursts of traffic up to this many requests in quick succession.
# Set to at least rate_limiter_requests_per_second to allow some burst capacity.
rate_limiter_burst_size = 20

# Enable adaptive backoff when the server responds with 429 (rate limited).
# Hard-coded default: True
# When True, the client automatically backs off (reduces request rate) for
# the duration of backoff_timeout_seconds, then resumes at the configured rate.
rate_limiter_adaptive_backoff = true

# Duration in seconds to back off when the server responds with 429.
# Hard-coded default: 60.0 seconds
# If the server provides a Retry-After header, that value is used instead (if longer).
rate_limiter_backoff_timeout_seconds = 60.0

# === Site Selection ===

# Active site name when no explicit target is provided.
# Can be overridden by the target_site environment variable.
target_site = 'production'

# === Per-site Configuration ===

# You can also define site-specific settings by creating [site_name] sections.
# These will override [default] values when that site is active.

[production]
# Override timeout for production (more conservative)
web_timeout = 30
web_timeout_long = 300

[development]
# Override timeout for development (more aggressive/faster fail)
web_timeout = 5
web_timeout_long = 50

[staging]
web_timeout = 15
web_timeout_long = 150
